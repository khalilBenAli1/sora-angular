{
  "name": "sora-angular",
  "version": "1.0.0",
  "scripts": {
    "dev": "ng serve --host 127.0.0.1 --port 4180",
    "start": "npm run dev",
    "build": "ng build --base-href /sora-angular/",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "ng test --watch=false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "preview": "node scripts/preview.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "jsdom": "^30.0.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.0"
  },
  "description": "A seasonal restaurant experience and local reservation desk, built with Angular.",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
